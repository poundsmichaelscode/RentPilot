# RENTpilot API
API_PORT=4000
CLIENT_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVER ONLY — never expose to browser code
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY

# Web -> API
API_INTERNAL_URL=http://localhost:4000

# Redis / background jobs
REDIS_URL=redis://127.0.0.1:6379

# Email
# Use console locally.
# Use smtp in production.
EMAIL_DELIVERY_MODE=console
EMAIL_FROM_NAME=RENTpilot
EMAIL_FROM_ADDRESS=no-reply@rentpilot.app

# Required only when EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Rent reminder scheduler
RENT_REMINDER_SCAN_INTERVAL_MS=900000

# Public web application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
